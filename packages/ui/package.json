{
  "name": "@roastpilot/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Design-system React components (shadcn/ui based), tokens.json and the generated CSS variables and Tailwind preset.",
  "exports": {
    ".": "./src/index.ts",
    "./globals.css": "./src/styles/globals.css",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./tokens.json": "./tokens.json"
  },
  "scripts": {
    "tokens": "node scripts/generate-tokens.ts && prettier --write src/styles/tokens.css src/styles/theme.css",
    "typecheck": "tsc --noEmit -p .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static"
  },
  "dependencies": {
    "@roastpilot/shared": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "tailwind-merge": "^3.7.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-themes": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  },
  "peerDependencies": {
    "react": ">=19"
  }
}
