{
  "name": "@roastpilot/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Design-system React components (shadcn/ui based), tokens.json and the generated CSS variables and Tailwind preset.",
  "exports": {
    ".": "./src/index.ts",
    "./globals.css": "./src/styles/globals.css",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "tokens": "node scripts/generate-tokens.ts && prettier --write src/styles/tokens.css src/styles/theme.css",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@roastpilot/shared": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "peerDependencies": {
    "react": ">=19"
  }
}
